# Application
NODE_ENV=development
APP_NAME=DANKOO_ELECTRONICS
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_NAME=DANKOO ELECTRONICS

# Backend
BACKEND_PORT=3001
BACKEND_HOST=0.0.0.0

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=dankoo_electronics
DATABASE_USER=dankoo_user
DATABASE_PASSWORD=secure_password_change_in_production
DATABASE_URL=postgresql://dankoo_user:secure_password_change_in_production@postgres:5432/dankoo_electronics

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@dankoo-electronics.com

# Payment Providers (to be configured)
# Chapa
CHAPA_API_KEY=your_chapa_api_key
CHAPA_SECRET_KEY=your_chapa_secret_key

# Telebirr
TELEBIRR_API_KEY=your_telebirr_api_key
TELEBIRR_MERCHANT_ID=your_telebirr_merchant_id

# CBE Birr
CBE_BIRR_API_KEY=your_cbe_birr_api_key
CBE_BIRR_MERCHANT_ID=your_cbe_birr_merchant_id

# OpenAI (for AI assistant)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4

# AWS S3 (for product images)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=dankoo-electronics-images

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp
UPLOAD_DIR=uploads/

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Shipping
DEFAULT_SHIPPING_COST=100
FREE_SHIPPING_THRESHOLD=5000

# Admin
ADMIN_EMAIL=admin@dankoo-electronics.com
ADMIN_PASSWORD=change_in_production

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
SESSION_SECRET=your_session_secret_change_in_production
BCRYPT_ROUNDS=10
